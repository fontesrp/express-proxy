{
  "name": "express-proxy",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "clean": "rm -rf node_modules package-lock.json yarn.lock",
    "format": "prettier --write \"**/*.{js,ts}\"",
    "prepare": "husky",
    "start": "DEBUG=express-proxy:* nodemon ./bin/www"
  },
  "dependencies": {
    "axios": "^1.18.1",
    "body-parser": "^2.3.0",
    "cookie-parser": "~1.4.7",
    "debug": "~4.4.3",
    "express": "~5.2.1",
    "form-data": "^4.0.6",
    "morgan": "~1.11.0",
    "multer": "^2.2.0",
    "nodemon": "^3.1.14",
    "qs": "^6.15.3"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.5"
  },
  "lint-staged": {
    "*.{js,ts}": "prettier --write"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
